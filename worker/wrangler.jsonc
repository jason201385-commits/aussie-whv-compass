{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aussie-whv-compass-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "https://www.aussiewhvcompass.com,https://aussiewhvcompass.com,http://127.0.0.1:4175,http://localhost:4175",
    "TURNSTILE_EXPECTED_HOSTNAME": "www.aussiewhvcompass.com",
    "TURNSTILE_EXPECTED_ACTION": "turnstile-spin-v2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aussie-whv-compass",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "DPLUS_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
